# ─────────────────────────────────────────────────────────────────────────────
# TransforM Egypt — API Server Environment Variables
# Copy this to .env for local dev, or add to Railway for production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database

# ── Admin Authentication ──────────────────────────────────────────────────────
# Must be at least 8 characters. Used to protect all /api/admin/* routes.
# Set this in Railway. Use in the Admin panel as the "Admin Token" field.
ADMIN_TOKEN=your-secret-admin-token-here

# ── Yara AI Chat (REQUIRED - Gemini) ─────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# This powers the main website chat widget (Yara). REQUIRED for chat to work.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override the model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ── Admin Inbox AI Drafts (Anthropic) ────────────────────────────────────────
# Powers AI draft generation for Instagram/Facebook DM replies in the admin inbox.
# Get from: https://console.anthropic.com/settings/keys
AI_INTEGRATIONS_ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional: use direct Anthropic key instead of Replit proxy
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── AI Reply Mode (Admin Inbox) ───────────────────────────────────────────────
# off = disabled, suggest = draft for admin approval, auto = send immediately
AI_REPLY_MODE_DMS=suggest
AI_REPLY_MODE_COMMENTS=suggest

# ── Meta / Facebook / Instagram ──────────────────────────────────────────────
META_PAGE_ID=your-facebook-page-id
META_PAGE_ACCESS_TOKEN=your-page-access-token
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=your-ig-business-account-id
# Webhook verification token (you choose this, set same in Meta dashboard)
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ── Meta Ads (optional) ──────────────────────────────────────────────────────
META_ADS_ACCOUNT_ID=act_your-ads-account-id
META_ADS_TOKEN=your-ads-token

# ── Yara Voice AI (ElevenLabs) ───────────────────────────────────────────────
# Powers the voice call widget on the website.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id
# Optional: voice IDs for TTS notifications
# ELEVENLABS_ARABIC_VOICE_ID=voice-id-for-arabic
# ELEVENLABS_ENGLISH_VOICE_ID=voice-id-for-english

# ── WhatsApp Automations (choose one provider) ───────────────────────────────
# Option A: Twilio (recommended for Egypt)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# Option B: Meta Cloud API (requires WhatsApp Business API access)
# META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ── ManyChat (optional) ──────────────────────────────────────────────────────
MANYCHAT_API_TOKEN=your-manychat-token
MANYCHAT_WEBHOOK_SECRET=your-manychat-webhook-secret
